import /vibrator-KJ5.rc

# =========================
# INIT (USB + core props)
# =========================
on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.state none

# =========================
# POST-FS-DATA (SAFE STORAGE STAGE)
# =========================
on post-fs-data
    mkdir /dev/.kmsg 0755 root root

    # DO NOT start adbd too early on MTK
    # wait until late-init for stability

# =========================
# BOOT STAGE
# =========================
on boot
    start health-hal-2-1
    start boot-hal-1-2

# =========================
# LATE INIT (CRITICAL FIX POINT)
# =========================
on late-init
    # Now storage + fstab are fully mounted
    start adbd

    # USB configuration only AFTER system stabilizes
    setprop sys.usb.config adb,mtp

    # MTK USB controller fix (guarded)
    write /sys/class/udc/musb-hdrc/device/cmode 2 2>/dev/null

    setprop sys.usb.state adb

# =========================
# FS STAGE (SAFETY ONLY)
# =========================
on fs
    # keep minimal, avoid early USB forcing
    setprop sys.usb.state none