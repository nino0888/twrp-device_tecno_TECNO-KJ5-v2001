import /init.decrypt.rc
import /vibrator-KJ5.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

# USB safe init (DO NOT force adbd here)
on post-fs-data
    write /sys/class/udc/musb-hdrc/device/cmode 2

# ADB controlled by recovery UI, not forced by init
on property:ro.debuggable=1
    start adbd

# MTK block device aliases (SAFE minimal only)
on early-init
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

# Health HAL (only if vendor_boot does NOT auto-start it)
on late-init
    start health-hal-2-1

# DO NOT start boot-hal manually in GKI recovery
# let vendor_boot handle it