# =========================
# Dynamic partitions (A/B logical)
# =========================
system      /system      ext4    ro,barrier=1,discard    wait,logical,first_stage_mount,slotselect
system_ext  /system_ext  ext4    ro,barrier=1,discard    wait,logical,first_stage_mount,slotselect
vendor      /vendor      ext4    ro,barrier=1,discard    wait,logical,first_stage_mount,slotselect
product     /product     ext4    ro,barrier=1,discard    wait,logical,first_stage_mount,slotselect

vendor_dlkm /vendor_dlkm ext4    ro,barrier=1,discard    wait,logical,slotselect
odm_dlkm    /odm_dlkm    ext4    ro,barrier=1,discard    wait,logical,slotselect

# =========================
# Metadata (CRITICAL for FBE + /data detection)
# =========================
/dev/block/by-name/metadata   /metadata   ext4    noatime,nosuid,nodev,discard    wait,check,formattable

# =========================
# Data (FIXED HYBRID SAFE)
# =========================
/dev/block/by-name/userdata   /data   f2fs   noatime,nosuid,nodev,discard,inlinecrypt    wait,check,formattable,quota,latemount

# =========================
# Cache (MTK legacy partition)
# =========================
/dev/block/by-name/tranfs     /cache  ext4    noatime,nosuid,nodev,discard    wait,check,formattable

# =========================
# Vendor persistent partitions
# =========================
/dev/block/by-name/persist    /mnt/vendor/persist    ext4    noatime,nosuid,nodev    wait
/dev/block/by-name/nvdata     /mnt/vendor/nvdata     ext4    noatime,nosuid,nodev    wait
/dev/block/by-name/nvcfg      /mnt/vendor/nvcfg      ext4    noatime,nosuid,nodev    wait
/dev/block/by-name/protect1   /mnt/vendor/protect_f  ext4    noatime,nosuid,nodev    wait
/dev/block/by-name/protect2   /mnt/vendor/protect_s  ext4    noatime,nosuid,nodev    wait

# =========================
# Boot / Flash partitions
# =========================
/dev/block/by-name/boot          /boot          emmc    defaults    defaults
/dev/block/by-name/vendor_boot   /vendor_boot   emmc    defaults    defaults
/dev/block/by-name/dtbo          /dtbo          emmc    defaults    defaults
/dev/block/by-name/vbmeta        /vbmeta        emmc    defaults    defaults