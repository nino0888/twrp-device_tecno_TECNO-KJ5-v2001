# =========================
# Android 13 MTK Stable FSTAB (KJ5)
# =========================

# Logical partitions (dynamic)
system          /system         ext4    ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
vendor          /vendor         ext4    ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
product         /product        ext4    ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
system_ext      /system_ext     ext4    ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount

vendor_dlkm     /vendor_dlkm    ext4    ro,barrier=1,discard   wait,slotselect,logical
odm_dlkm        /odm_dlkm       ext4    ro,barrier=1,discard   wait,slotselect,logical

# =========================
# Metadata (IMPORTANT for A13)
# =========================
/dev/block/by-name/metadata     /metadata      ext4    noatime,nosuid,nodev,discard   wait,check,formattable

# =========================
# Userdata (STABLE - simplified)
# =========================
/dev/block/by-name/userdata     /data          f2fs    noatime,nosuid,nodev,discard,inlinecrypt   wait,check,formattable

# =========================
# Cache (if present)
# =========================
/dev/block/by-name/tranfs       /cache         ext4    noatime,nosuid,nodev,discard   wait,check,formattable

# =========================
# Misc (bootloader communication)
# =========================
/dev/block/by-name/misc         /misc          emmc    defaults   defaults