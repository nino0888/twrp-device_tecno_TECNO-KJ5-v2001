# =========================
# Fstab / Recovery behavior
# =========================
ro.postinstall.fstab.prefix=/system

# =========================
# ADB (RECOVERY SAFE MODE)
# =========================
ro.adb.secure=0
ro.debuggable=1

# NOTE:
# ro.secure is handled by recovery build flags
# DO NOT force ro.secure=0 here

# =========================
# USB / MTP
# =========================
persist.sys.usb.config=mtp,adb
sys.usb.config=mtp,adb
ro.sys.usb.storage.type=mtp

# OTG flag (safe hint only, real OTG is kernel-controlled)
persist.sys.isUsbOtgEnabled=1

# =========================
# TEE / Gatekeeper (READ-ONLY INFO ONLY)
# =========================
ro.hardware.gatekeeper=trustonic

ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_trustonic_tee_support=1

# =========================
# IMPORTANT NOTES
# =========================
# DO NOT add:
# - keymaster_ver (invalid property)
# - duplicate USB configs
# - ro.secure override (handled by recovery build system)