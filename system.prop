# =========================
# Fstab / Postinstall
# =========================
ro.postinstall.fstab.prefix=/system

# =========================
# ADB (DEBUG ENABLED FOR TWRP)
# =========================
ro.secure=0
ro.adb.secure=0
ro.debuggable=1
persist.sys.usb.config=adb,mtp

# =========================
# USB (STABLE)
# =========================
sys.usb.config=adb,mtp
persist.sys.isUsbOtgEnabled=true

# =========================
# DISABLE CRYPTO (IMPORTANT FOR 0MB FIX)
# =========================
# These cause decryption attempts → breaks /data mount
# REMOVE metadata encryption flags completely

# ro.crypto.volume.filenames_mode ❌ REMOVE
# ro.crypto.support_metadata_encrypt ❌ REMOVE

# =========================
# TEE (SAFE KEEP)
# =========================
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_trustonic_tee_support=1

# =========================
# Gatekeeper / Keymaster (SAFE MINIMAL)
# =========================
ro.hardware.gatekeeper=trustonic
keymaster_ver=4.1

# REMOVE THIS (causes issues sometimes)
# ro.hardware.kmsetkey=trustonic ❌

# =========================
# OPTIONAL (helps some MTK recoveries)
# =========================
ro.boot.dynamic_partitions=true
ro.boot.slot_suffix=_a